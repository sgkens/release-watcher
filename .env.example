PORT=4317
RW_HOST=0.0.0.0                 # 127.0.0.1 to keep it local
RW_HTTP_TIMEOUT_MS=15000
RW_DB=data/release-watcher.db
RW_POLL_MINUTES=60
# Optional tokens per git host (raises rate limits, unlocks private repos)
# RW_TOKEN_GITHUB_COM=ghp_xxx
# RW_TOKEN_GITLAB_COM=glpat-xxx
# RW_TOKEN_CODEBERG_ORG=xxx
# RW_TOKEN_GIT_HOME_LAN=xxx

# Drift alerts (both optional)
# RW_NTFY_URL=https://ntfy.sh/my-releases        # or your self-hosted ntfy topic
# RW_NTFY_TOKEN=tk_xxx                            # protected topics
# RW_WEBHOOK_URL=https://example.lan/hook         # JSON {title, body, tags, priority, click}
# RW_ALERT_AFTER_HOURS=24                         # grace window after a tag before alerting
# RW_PUBLIC_URL=http://release-watcher.home.lan   # makes notification clicks open the app
