{
  "name": "release-watcher",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "author": "Garvey K Snow",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
